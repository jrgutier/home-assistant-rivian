// See https://aka.ms/vscode-remote/devcontainer.json for format details.
{
  "name": "Home Assistant integration development",
  // HA 2026.8.2 requires Python >= 3.14.2. Keep in step with requirements.txt
  // and .github/workflows/test.yaml -- all three pin the same interpreter.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.14-bookworm",
  "postCreateCommand": ".devcontainer/setup",
  "forwardPorts": [8123],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.pylint",
        "esbenp.prettier-vscode",
        "github.vscode-pull-request-github",
        "ryanluker.vscode-coverage-gutters",
        "charliermarsh.ruff"
      ],
      "settings": {
        "files.eol": "\n",
        "editor.tabSize": 4,
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.analysis.autoSearchPaths": false,
        "editor.formatOnPaste": false,
        "editor.formatOnSave": true,
        "editor.formatOnType": true,
        "editor.codeActionsOnSave": {
          "source.organizeImports": "explicit"
        },
        "files.trimTrailingWhitespace": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        }
      }
    }
  },
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/rust:1": {}
  }
}
